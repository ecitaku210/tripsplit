{
  "name": "tripsplit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first PWA for splitting trip expenses. No server, no accounts.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-built-css.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "icons": "node scripts/make-icons.mjs",
    "check:phone": "node scripts/phone-check.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-tripsplit 'vitest run -c vitest.emulator.config.ts'"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "oxlint": "1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@google-cloud/pubsub": "^6.3.0",
    "chokidar": "^4.0.3"
  }
}
